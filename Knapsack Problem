#include <stdio.h>

// Utility function to find the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int N, W;

    // Read the number of items
    if (scanf("%d", &N) != 1) return 0;

    int values[1005], weights[1005];

    // Read values of the items
    for (int i = 0; i < N; i++) {
        scanf("%d", &values[i]);
    }

    // Read weights of the items
    for (int i = 0; i < N; i++) {
        scanf("%d", &weights[i]);
    }

    // Read the knapsack capacity
    scanf("%d", &W);

    // DP table to store the maximum value for each item and capacity combination
    // Using a 1D or 2D array. For constraints N <= 1000 and W <= 1000, 
    // a 2D array dp[1005][1005] fits well within standard stack/heap limits.
    static int dp[1005][1005];

    // Build the DP table in bottom-up manner
    for (int i = 0; i <= N; i++) {
        for (int w = 0; w <= W; w++) {
            if (i == 0 || w == 0) {
                dp[i][w] = 0;
            } else if (weights[i - 1] <= w) {
                dp[i][w] = max(values[i - 1] + dp[i - 1][w - weights[i - 1]], dp[i - 1][w]);
            } else {
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

    // Print the maximum value for N items and capacity W
    printf("%d\n", dp[N][W]);

    return 0;
}
