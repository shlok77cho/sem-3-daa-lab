#include <stdio.h>
    while (edgeCount < V - 1) {
        int min = INT_MAX;
        int a = -1, b = -1;

        // Find the minimum edge (upper triangular matrix only)
        for (int i = 0; i < V; i++) {
            for (int j = i + 1; j < V; j++) {
                if (cost[i][j] < min) {
                    min = cost[i][j];
                    a = i;
                    b = j;
                }
            }
        }

        // Find root of a
        int u = a;
        while (parent[u] != u)
            u = parent[u];

        // Find root of b
        int v = b;
        while (parent[v] != v)
            v = parent[v];

        // If no cycle, include the edge
        if (u != v) {
            printf("Edge %d:(%d, %d) cost:%d\n", edgeCount, a, b, min);
            minCost += min;
            parent[v] = u;
            edgeCount++;
        }

        // Remove the processed edge
        cost[a][b] = cost[b][a] = INT_MAX;
    }

    printf("Minimum cost= %d\n", minCost);
}




