#include <stdio.h>
#include <limits.h>

#define MAX 15
#define INF 9999999

int n;
int cost[MAX][MAX];
int min_cost = INF;

void tsp(int curr_pos, int count, int cost_so_far, int visited[]) {
    // If all cities are visited and there is a path back to the starting city (city 0)
    if (count == n && cost[curr_pos][0] != -1) {
        int total_cost = cost_so_far + cost[curr_pos][0];
        if (total_cost < min_cost) {
            min_cost = total_cost;
        }
        return;
    }

    // Try visiting all unvisited cities
    for (int i = 0; i < n; i++) {
        if (!visited[i] && cost[curr_pos][i] != -1) {
            visited[i] = 1;
            tsp(i, count + 1, cost_so_far + cost[curr_pos][i], visited);
            visited[i] = 0; // Backtrack
        }
    }
}

int main() {
    if (scanf("%d", &n) != 1) return 0;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    int visited[MAX] = {0};

    // Mark the first city as visited and start from it (index 0)
    visited[0] = 1;
    tsp(0, 1, 0, visited);

    // Print the optimal cost
    printf("%d\n", min_cost);

    return 0;
}
